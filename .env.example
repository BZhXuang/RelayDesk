# Copy to .env; never commit the populated file.
# DeepSeek's Anthropic-compatible endpoint was used for online verification.
ANTHROPIC_API_KEY=replace-with-your-own-model-key
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Required by Compose. Use a long random, URL-safe value.
REDIS_PASSWORD=replace-with-a-long-random-value

# Local demo mode. See README security notes before exposing a deployment.
RELAYDESK_ENV=development
RELAYDESK_SEED_DEMO_DOCS=true
MCP_EXTERNAL_ENABLED=true

# Loopback host ports
API_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_UI_PORT=9090
